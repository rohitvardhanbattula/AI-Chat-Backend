{
  "name": "ai-chat-backend",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@abaplint/core": "^2.115.28",
    "@cap-js/hana": "^2.6.0",
    "@google/genai": "^2.2.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sap-ai-sdk/orchestration": "^2.7.0",
    "@sap-cloud-sdk/connectivity": "^4.5.1",
    "@sap-cloud-sdk/http-client": "^4.5.1",
    "@sap-cloud-sdk/mail-client": "^3.24.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4.12.2",
    "abap-adt-api": "^8.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
